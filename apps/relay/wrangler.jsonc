{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remote-link-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "DeviceRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DeviceRegistry"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "remotearc.app",
      "custom_domain": true
    },
    {
      "pattern": "www.remotearc.app",
      "custom_domain": true
    },
    {
      "pattern": "mcp.remotearc.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../ui/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remote-link-auth",
      "database_id": "5ceaf634-11ea-47e4-9834-12a133e3adcb",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://mcp.remotearc.app",
    "APP_ORIGIN": "https://mcp.remotearc.app",
    "MARKETING_ORIGIN": "https://remotearc.app",
    "ALLOW_SIGNUPS": "1",
    "MONTHLY_TOOL_CALL_LIMIT": "10000",
    "REVIEWER_DEMO_DEVICE_ID": "review-desktop-v1",
    "REVIEWER_EMAIL": "openai-reviewer@remotearc.app"
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
