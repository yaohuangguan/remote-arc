{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remote-link-relay",
  "account_id": "6b1d0dd4e6f7f30df92753cd1e2ee12d",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "cache": {
    "enabled": false
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    }
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "*/5 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "DeviceRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DeviceRegistry"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "remotearc.app",
      "custom_domain": true
    },
    {
      "pattern": "www.remotearc.app",
      "custom_domain": true
    },
    {
      "pattern": "mcp.remotearc.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../ui/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/demos/*",
      "!/downloads/*",
      "!/*.svg",
      "!/*.png",
      "!/manifest.webmanifest",
      "!/sw.js"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remote-link-auth",
      "database_id": "3cf318cb-99e4-4bc8-af20-55d634e354fd",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://mcp.remotearc.app",
    "APP_ORIGIN": "https://mcp.remotearc.app",
    "MARKETING_ORIGIN": "https://remotearc.app",
    "ALLOW_SIGNUPS": "1",
    "MONTHLY_TOOL_CALL_LIMIT": "10000",
    "MCP_METRICS_SAMPLE_RATE": "0.1",
    "AUDIT_ARCHIVE_ENABLED": "0",
    "AUDIT_RETENTION_DAYS": "30",
    "OPERATOR_EMAIL": "moviegoer24@gmail.com",
    "REVIEWER_DEMO_DEVICE_ID": "review-desktop-v1",
    "REVIEWER_EMAIL": "openai-reviewer@remotearc.app",
    "ALERT_EMAIL": "moviegoer24@gmail.com",
    "ALERT_FROM_EMAIL": "alerts@remotearc.app",
    "ENABLE_EXPERIMENTAL_AGENT_GOALS": "0"
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "MCP_EDGE_RATE_LIMITER",
      "namespace_id": "41004",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "MCP_ANON_RATE_LIMITER",
      "namespace_id": "41005",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "INCIDENT_RATE_LIMITER",
      "namespace_id": "41006",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "EMAIL_RATE_LIMITER",
      "namespace_id": "41003",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
