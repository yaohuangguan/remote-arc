{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remote-link-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "DeviceRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DeviceRegistry"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "remote.samyao.me",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../ui/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/agent",
      "/mcp",
      "/mcp/*",
      "/health",
      "/.well-known/*",
      "/oauth/*",
      "/auth/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remote-link-auth",
      "database_id": "5ceaf634-11ea-47e4-9834-12a133e3adcb",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://remote.samyao.me",
    "ALLOW_SIGNUPS": "1",
    "MONTHLY_TOOL_CALL_LIMIT": "10000"
  }
}
