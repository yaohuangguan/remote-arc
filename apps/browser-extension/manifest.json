{
  "manifest_version": 3,
  "name": "Remote Arc Browser",
  "version": "0.2.0",
  "description": "Share selected browser tabs with AI, with per-tab read and interaction permission.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://mcp.remotearc.app/*"
  ],
  "action": {
    "default_title": "Remote Arc Browser",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
