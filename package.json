{
  "name": "remotearc-monorepo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:mcp": "pnpm --filter @remotearc/mcp dev",
    "dev:agent": "pnpm --filter @remotearc/agent dev",
    "dev:relay": "pnpm --filter @remotearc/relay dev",
    "dev:ui": "pnpm --filter @remotearc/ui dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @remotearc/mcp test:smoke",
    "ci": "pnpm typecheck && pnpm test",
    "build:ui": "pnpm --filter @remotearc/ui build",
    "deploy:relay": "pnpm build:ui && pnpm --filter @remotearc/relay run deploy",
    "build:cli": "pnpm --filter remotelink build",
    "publish:cli": "pnpm build:cli && grep -q '0.3.5' packages/cli/dist/index.js && grep -q 'https://mcp.remotearc.app' packages/cli/dist/index.js && grep -q '/api/device/heartbeat' packages/cli/dist/index.js && cd packages/cli && npm publish"
  },
  "bin": {
    "remotelink": "bin/remotearc.js",
    "remote-link": "bin/remotearc.js",
    "remote-arc": "bin/remotearc.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "ws": "^8.18.3"
  },
  "files": [
    "bin"
  ]
}
